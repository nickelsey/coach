# One of these per environment, on the NAS at /volume1/docker/coach/<env>/.env
# (root-owned, mode 600). Never commit a filled-in copy.

# The machine's name on the tailnet: coach for prod, coach-dev for dev.
TS_HOSTNAME=coach

# Tailscale auth key for that machine (admin console > Settings > Keys). Tag
# it tag:coach-prod or tag:coach-dev so the machine never expires. It's only
# used for the first login; after that the saved state in DATA_DIR counts.
TS_AUTHKEY=

# Generate both with: openssl rand -hex 32
# (hex keeps them URL-safe, since the password goes into DATABASE_URL)
# Use different values in dev and prod.
POSTGRES_PASSWORD=
COACH_API_TOKEN=

# Where this environment's container data lives.
DATA_DIR=/volume1/docker/coach/prod/data

# Prod only: where the backup before each deploy goes.
BACKUP_DIR=/volume1/backups/coach
