# Copy to .env and fill in. Never commit .env.

# Tailscale auth key for the "coach" node (admin console > Settings > Keys).
# Use a reusable or pre-approved key, and tag it if you use ACL tags.
TS_AUTHKEY=

# Generate both with: openssl rand -hex 32
# (hex keeps them URL-safe, since the password goes into DATABASE_URL)
POSTGRES_PASSWORD=
COACH_API_TOKEN=

# Where container data lives. On the Synology, use a path on the volume,
# e.g. /volume1/docker/coach/data
DATA_DIR=./data
